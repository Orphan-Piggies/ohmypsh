# agent — the oracle. `??` asks in plain words; `oops` explains the
# last failure. The THINKING is an external AI CLI ($OMP_AI_CMD,
# default "claude -p"); the ANSWER lands in the cockpit via
# $PSH_PRELOAD — editable, highlighted by the real lexer, run only
# when a human presses Enter. Never auto-executed. If a suggestion
# looks spicy, audition it in `cage` first.
#
#   ?? find videos over 100M changed last week
#   oops                     (right after something failed)
#   ask <words>              same as ??, for the ?-averse
#
# $OMP_AI_CMD may be several words; psh never splits variables, so
# the plugin splits it the honest way — through $( ) newlines.
# Local oracles work too (tested):
#   OMP_AI_CMD="ollama run qwen2.5"                      # snappy
#   OMP_AI_CMD="ollama run llama3.1"
#   OMP_AI_CMD="ollama run gemma3"
#   OMP_AI_CMD="ollama run --think=false deepseek-r1:8b" # reasoner,
#                            # slow but sure; without --think=false
#                            # it soliloquizes for ten minutes

if [ "$OMP_AI_CMD" = "" ]; then
    OMP_AI_CMD="claude -p"
fi

# Streaming CLIs (ollama) redraw with ANSI cursor codes ON STDOUT;
# scrub those and stray \r before anything reads the reply.
__omp_agent_run() {
    $(echo $OMP_AI_CMD | tr " " "\n") "$1" 2> /dev/null \
        | sed "s/$(printf '\033')\[[0-9;]*[A-Za-z]//g" | tr -d "\r"
}

# Pick the ONE line to stage. Reasoning models (deepseek-r1) stream
# their whole soliloquy first and fence the final answer — so if the
# reply has a code fence, the answer lives inside it. Otherwise take
# the first line that isn't part of a thinking block.
__omp_agent_stage() {
    local line infence skip
    infence=no
    for line in $(echo $1); do
        case $line in
            '```'*)
                if [ "$infence" = "yes" ]; then
                    break
                fi
                infence=yes
                ;;
            *)
                if [ "$infence" = "yes" ]; then
                    PSH_PRELOAD=$line
                    return 0
                fi
                ;;
        esac
    done
    skip=no
    for line in $(echo $1); do
        case $line in
            'Thinking...'*|'<think>'*) skip=yes ;;
            '...done thinking'*|'</think>'*) skip=no ;;
            *)
                if [ "$skip" = "no" ]; then
                    PSH_PRELOAD=$line
                    return 0
                fi
                ;;
        esac
    done
    echo "the oracle said nothing (is $OMP_AI_CMD installed?)" >&2
    return 1
}

??() {
    local st q ctx reply
    st=$?
    q="$@"
    if [ "$q" = "" ]; then
        echo "??: ask in plain words:  ?? find big log files" >&2
        return 2
    fi
    ctx="cwd=$PWD"
    if command -v git > /dev/null; then
        ctx="$ctx, git branch=$(git branch --show-current 2> /dev/null)"
    fi
    reply=$(__omp_agent_run "Reply with ONLY one shell command — POSIX sh compatible (no [[, no arrays, no process substitution), one line, no explanation, no code fences. Task: $q. Context: $ctx, last exit status $st.")
    __omp_agent_stage "$reply"
}

ask() { ?? "$@"; }

oops() {
    local st last reply
    st=$?
    last=$(history 2 | head -n 1 | sed 's/^ *[0-9]* *//')
    if [ "$last" = "" ]; then
        echo "oops: no history to explain" >&2
        return 1
    fi
    reply=$(__omp_agent_run "The shell command [$last] just exited with status $st in $PWD. Reply with ONLY a corrected version of the command — POSIX sh compatible, one line, no explanation, no code fences.")
    __omp_agent_stage "$reply"
}
