# shell-shock — the legendary plugin from the founding documents:
# "Səhv kod yazanda XIRT səsi çıxaran plagin."
# Registers on the precmd hook; $__OMP_STATUS carries the last
# command's status (captured by the dispatcher before anything else
# could overwrite it).

__omp_shellshock_precmd() {
    if [ "$__OMP_STATUS" != "0" ]; then
        echo "🫛 XIRT! (exit $__OMP_STATUS)"
    fi
}

omp_hook_precmd __omp_shellshock_precmd
